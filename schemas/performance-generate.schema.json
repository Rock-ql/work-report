{
  "$ref": "#/definitions/performanceGenerateSchema",
  "definitions": {
    "performanceGenerateSchema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "type": "string",
              "const": "daily"
            }
          },
          "required": [
            "sourceType"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sourceType": {
              "type": "string",
              "const": "offline"
            },
            "text": {
              "type": "string",
              "pattern": "\\S"
            },
            "filename": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "sourceType",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "绩效生成请求，规则抽取且不保存"
}
